# Lenovo AR9565 PCI Wi-Fi; reuse Google's cfg80211/mac80211 helpers.
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=m
CONFIG_ATH9K=m
CONFIG_ATH9K_HW=m
CONFIG_ATH9K_COMMON=m
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_PCOEM=y
CONFIG_ATH9K_BTCOEX_SUPPORT=y
CONFIG_ATH9K_RFKILL=y
CONFIG_MAC80211_LEDS=y
# The AR3012 Bluetooth half needs ath3k's firmware upload; btusb itself stays Google's.
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_ATH3K=m
# BT_ATH3K needs BT_HCIBTUSB; our btusb.ko is not shipped, so keep its default-on options out.
# CONFIG_BT_HCIBTUSB_BCM is not set
# CONFIG_BT_HCIBTUSB_RTL is not set
# CONFIG_BT_HCIBTUSB_POLL_SYNC is not set
