Android's composer (drm_hwcomposer) sets DRM_MODE_ATOMIC_ALLOW_MODESET on every page flip and test
commit. On display engines older than DCN 3.2 (the MSI's Barcelo is DCN 2.1) amdgpu treats any
commit that allows a modeset as a full update: it resets every plane and takes the global lock,
which waits for pending flips on all displays. With the internal panel and an HDMI monitor each
display's flip waits for the other's, so both drop to about half their frame rate. Keep the full
update only when a CRTC really needs a modeset; plain flips then take the same fast path that
desktop Linux compositors, which do not set the flag on flips, already use on DCN 2.1.
Drop when upstream removes the pre-DCN 3.2 hack or drm_hwcomposer stops allowing modesets on flips.

--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -11440,6 +11440,19 @@
 	return ret;
 }
 
+static bool dm_state_needs_modeset(struct drm_atomic_state *state)
+{
+	struct drm_crtc_state *new_crtc_state;
+	struct drm_crtc *crtc;
+	int i;
+
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i)
+		if (drm_atomic_crtc_needs_modeset(new_crtc_state))
+			return true;
+
+	return false;
+}
+
 static bool should_reset_plane(struct drm_atomic_state *state,
 			       struct drm_plane *plane,
 			       struct drm_plane_state *old_plane_state,
@@ -11459,7 +11472,7 @@
 	 * fast updates works fine on DCN3.2+.
 	 */
 	if (amdgpu_ip_version(adev, DCE_HWIP, 0) < IP_VERSION(3, 2, 0) &&
-	    state->allow_modeset)
+	    state->allow_modeset && dm_state_needs_modeset(state))
 		return true;
 
 	/* Check for writeback commit */
