# Keep Google's e1000e/igc/r8169/iwlwifi and wireless helpers unchanged.
# Build only missing upstream Ethernet and PCIe Wi-Fi modules.
CONFIG_IGB=m
CONFIG_IGB_HWMON=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_LEDS=y
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
