# Google's audio HAL uses its board mapping's card ID, not SoundCardName alone.
on boot && property:ro.boot.gbos_builder.graphics=amd
    start vendor.gbos_builder.audio

on boot && property:ro.boot.gbos_builder.graphics=amd-vulkan
    start vendor.gbos_builder.audio

service vendor.gbos_builder.audio /vendor/bin/get_variant_audio /sys ALC256
    user root
    group root
    disabled
    oneshot

on property:vendor.audio.gbos_builder.ready=ALC256
    restart vendor.audio-hal-aidl
