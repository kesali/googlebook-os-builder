# Our changes to Google's kernel configuration (out/google/kernel/config).
# Everything else stays Google's: tools/kconfig_check.py fails the build if a
# built-in (=y) setting changes without being listed here.

# Trust the key Google signed its modules with (tools/kernel_certs.py writes
# this file into the build directory).
CONFIG_SYSTEM_TRUSTED_KEYS="google-certs.pem"

# First laptop boot (docs/specs/laptop-hardware.md): the MSI laptop's touchpad and the kernel
# log on its screen. Both must work before Android starts, so they are built in rather than
# modules. Built-in code needs no exports, so Google's ABI list and symbol CRCs stay as they are.

# Touchpad: the AMD ACPI platform device gives the I2C controller (AMDI0010) its clock, the AMD
# GPIO controller carries the touchpad's interrupt, and the touchpad speaks HID over I2C.
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_PINCTRL_AMD=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_HID_ACPI=y
# Selected by I2C_HID_ACPI; kconfig_check.py wants every new built-in listed.
CONFIG_I2C_HID_CORE=y

# Kernel log on the screen without the VT console or fbdev: the firmware framebuffer becomes a
# DRM device (simpledrm) and drm_log prints the log on it until Android's graphics takes over.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_CLIENT_LOG=y
CONFIG_DRM_CLIENT_DEFAULT_LOG=y
# Selected by the four above.
CONFIG_SYSFB=y
CONFIG_BOOT_VESA_SUPPORT=y
CONFIG_APERTURE_HELPERS=y
CONFIG_DRM_SYSFB_HELPER=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_CLIENT_SETUP=y
CONFIG_DRM_CLIENT_LIB=y
CONFIG_DRM_DRAW=y

# Barcelo/Renoir display driver. Keep it modular; the firmware is available only after
# Android mounts vendor. Google's prebuilt helpers remain in use where they already exist.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y
# Selected display-protocol helpers; kABI checks still require every Google CRC unchanged.
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_DISPLAY_HDCP_HELPER=y
CONFIG_DRM_DISPLAY_HDMI_HELPER=y
CONFIG_DRM_DISPLAY_HDMI_CEC_NOTIFIER_HELPER=y

# AMD plus Google's modules exceed vendor_dlkm's fixed size with LZ4. Zstd fits without
# removing drivers or changing the partition layout; the decompressor is already built in.
CONFIG_EROFS_FS_ZIP_ZSTD=y

# Wi-Fi: MediaTek MT7922 (mt7921e). Google's vendor_dlkm already has cfg80211 and mac80211;
# they are built here only so mt76 compiles, and the image check loads ours against Google's.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
# A bool menu gate, off in GKI; without it mt76 is never built.
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
# Defaults of the options above; they affect only these modules, not the kernel image.
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_MAC80211_HAS_RC=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_MT76_LEDS=y
