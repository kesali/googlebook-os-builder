# Our changes to Google's kernel configuration (out/google/kernel/config).
# tools/kconfig_check.py requires every new built-in here or in a selected recipe.
CONFIG_SYSTEM_TRUSTED_KEYS="google-certs.pem"

# MSI touchpad: ACPI clock, AMD GPIO interrupt, HID over DesignWare I2C.
# Built in so input works before vendor is mounted; preserve Google's export CRCs.
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_PINCTRL_AMD=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_HID_CORE=y
# recipe: elantech-ps2/gki.config
# recipe: common-touchpads/gki.config
# recipe: drm-handoff/gki.config
# recipe: amdgpu/gki.config
# recipe: i915/gki.config

# The combined modules fit vendor_dlkm with Zstd, without removing Google's modules.
CONFIG_EROFS_FS_ZIP_ZSTD=y

# recipe: mt7922/gki.config
# recipe: ar9565/gki.config
# recipe: common-network/gki.config
# recipe: renoir-acp/gki.config
