# Our changes to Google's kernel configuration (out/google/kernel/config).
# Everything else stays Google's: tools/kconfig_check.py fails the build if a
# built-in (=y) setting changes without being listed here.

# Keep every exported symbol, not only those Google's modules use: the extra
# drivers below need some of the others.
# CONFIG_TRIM_UNUSED_KSYMS is not set

# Trust the key Google signed its modules with (tools/kernel_certs.py writes
# this file into the build directory).
CONFIG_SYSTEM_TRUSTED_KEYS="google-certs.pem"

# QEMU devices Google's kernel has no driver for. Modules, so the kernel itself
# (and every symbol CRC) stays Google's.
CONFIG_DRM_VIRTIO_GPU=m
# Display (mode setting) part of the virtio-gpu module above, not the kernel.
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_VIRTIO_INPUT=m
CONFIG_VIRTIO_NET=m
# Virtual GEM: a render node for Mesa's software renderer to share buffers with
# the display.
CONFIG_DRM_VGEM=m
