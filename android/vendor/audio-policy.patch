Let the audio selector rename only the MSI analog card ID, which Google's unchanged HAL needs.
Ueventd applies this precise sysfs label when the card appears. Keep enforcing; no generic sysfs
write access. Drop together with the MSI audio selector.

--- a/etc/selinux/vendor_sepolicy.cil
+++ b/etc/selinux/vendor_sepolicy.cil
@@ -9275,3 +9275,11 @@
 (typeattributeset base_typeattr_244_202604 (and (domain) (not (dumpstate_202604 init_202604))))
 ;;* lme
 
+; Only the MSI analog card's id is writable; never grant generic sysfs writes.
+(type dali_audio_id)
+(roletype object_r dali_audio_id)
+(typeattributeset fs_type (dali_audio_id))
+(typeattributeset sysfs_type (dali_audio_id))
+(allow get_variant_audio dali_audio_id (file (getattr open read write)))
+(allow dali_hardware_diag dali_audio_id (file (getattr open read)))
+(allow hal_audio_default dali_audio_id (file (getattr open read)))
--- a/etc/ueventd.rc
+++ b/etc/ueventd.rc
@@ -166,3 +166,6 @@
 /dev/mtd* 0664 system system
 /proc/mtd 0444 system ap_firmware
 /dev/nvram 0664 system system
+
+# Apply the narrow card-ID label when the MSI's analog HDA card appears.
+/sys/devices/pci0000:00/0000:00:08.1/0000:03:00.6/sound/card* id 0644 root root
