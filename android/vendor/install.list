# Files added to Google's vendor partition. See scripts/android-overlay.sh.
# Sources: ./ is this directory; emulator/ is the pinned Android emulator image
# (scripts/emulator.sh), mesa/ is our Mesa build and build/ is out/android.
#
# path                                                                   mode owner  selinux type                source

# MSI ALC256 setup; keep Google's audio HAL and select its expected card ID.
bin/get_variant_audio                                                   0755 0:2000 get_variant_audio_exec      ./get_variant_audio
etc/init/dali-audio.rc                                                   0644 0:0    vendor_configs_file         ./audio-msi.rc

# Extend the software codec sandbox only for Mesa's CPU-affinity query.
etc/seccomp_policy/mediaswcodec.policy                                   0644 0:0    vendor_configs_file         ./mediaswcodec.policy

# Software KeyMint, unmodified from Google's emulator image. Not hardware-backed.
bin/hw/android.hardware.security.keymint-service                         0755 0:2000 hal_keymint_default_exec    emulator/vendor/bin/hw/android.hardware.security.keymint-service
etc/init/android.hardware.security.keymint-service.rc                    0644 0:0    vendor_configs_file         emulator/vendor/etc/init/android.hardware.security.keymint-service.rc
etc/vintf/manifest/android.hardware.security.keymint-service.xml         0644 0:0    vendor_configs_file         emulator/vendor/etc/vintf/manifest/android.hardware.security.keymint-service.xml
etc/vintf/manifest/android.hardware.security.secureclock-service.xml     0644 0:0    vendor_configs_file         emulator/vendor/etc/vintf/manifest/android.hardware.security.secureclock-service.xml
etc/vintf/manifest/android.hardware.security.sharedsecret-service.xml    0644 0:0    vendor_configs_file         emulator/vendor/etc/vintf/manifest/android.hardware.security.sharedsecret-service.xml

# Software Gatekeeper, from the emulator's nonsecure Gatekeeper APEX.
bin/hw/android.hardware.gatekeeper-service                               0755 0:2000 hal_gatekeeper_default_exec emulator/gatekeeper/bin/hw/android.hardware.gatekeeper-service.nonsecure
etc/init/android.hardware.gatekeeper-service.rc                          0644 0:0    vendor_configs_file         ./gatekeeper.rc
etc/vintf/manifest/android.hardware.gatekeeper-service.nonsecure.xml     0644 0:0    vendor_configs_file         emulator/gatekeeper/etc/vintf/android.hardware.gatekeeper-service.nonsecure.xml
etc/vintf/manifest/android.hardware.security.sharedsecret-gatekeeper.xml 0644 0:0    vendor_configs_file         emulator/gatekeeper/etc/vintf/android.hardware.security.sharedsecret-gatekeeper.xml

# Libraries the two services need that Google's vendor partition lacks.
lib64/libcppbor.so                                                       0644 0:0    vendor_file                 emulator/vendor/lib64/libcppbor.so
lib64/libcppcose_rkp.so                                                  0644 0:0    vendor_file                 emulator/vendor/lib64/libcppcose_rkp.so
lib64/libkeymaster_portable.so                                           0644 0:0    vendor_file                 emulator/vendor/lib64/libkeymaster_portable.so
lib64/libkeymint.so                                                      0644 0:0    vendor_file                 emulator/vendor/lib64/libkeymint.so
lib64/libpuresoftkeymasterdevice.so                                      0644 0:0    vendor_file                 emulator/vendor/lib64/libpuresoftkeymasterdevice.so
lib64/libsoft_attestation_cert.so                                        0644 0:0    vendor_file                 emulator/vendor/lib64/libsoft_attestation_cert.so

# Source-built Mesa softpipe: CPU-rendered EGL/GLES for QEMU's virtio-gpu display.
lib64/egl/                                                               0755 0:0    vendor_file                 -
lib64/egl/libEGL_mesa.so                                                 0644 0:0    same_process_hal_file       mesa/lib64/libEGL_mesa.so
lib64/egl/libGLESv1_CM_mesa.so                                           0644 0:0    same_process_hal_file       mesa/lib64/libGLESv1_CM_mesa.so
lib64/egl/libGLESv2_mesa.so                                              0644 0:0    same_process_hal_file       mesa/lib64/libGLESv2_mesa.so
lib64/libgallium_dri.so                                                  0644 0:0    same_process_hal_file       mesa/lib64/libgallium_dri.so
lib64/hw/vulkan.radeon.so                                                0644 0:0    same_process_hal_file       mesa/lib64/libvulkan_radeon.so
lib64/libgbm_mesa.so                                                     0644 0:0    same_process_hal_file       mesa/lib64/libgbm_mesa.so
lib64/gbm/                                                              0755 0:0    vendor_file                 -
lib64/gbm/dri_gbm.so                                                     0644 0:0    same_process_hal_file       mesa/lib64/gbm/dri_gbm.so

# The AMD backend uses Mesa GBM; QEMU still uses minigbm's upstream virtio backend.
lib64/libgbm.so                                                          0644 0:0    same_process_hal_file       minigbm/libgbm.so
lib64/libminigbm_gralloc.so                                               0644 0:0    same_process_hal_file       minigbm/libminigbm_gralloc.so
lib64/libgbm_mesa_wrapper.so                                              0644 0:0    same_process_hal_file       minigbm/libgbm_mesa_wrapper.so

# Runtime GPU firmware, not firmware-update utilities.
firmware/amdgpu/                  0755 0:0 vendor_firmware_file -
firmware/amdgpu/renoir_asd.bin     0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_asd.bin
firmware/amdgpu/renoir_ce.bin      0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_ce.bin
firmware/amdgpu/renoir_dmcub.bin   0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_dmcub.bin
firmware/amdgpu/renoir_gpu_info.bin 0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_gpu_info.bin
firmware/amdgpu/renoir_me.bin      0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_me.bin
firmware/amdgpu/renoir_mec.bin     0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_mec.bin
firmware/amdgpu/renoir_mec2.bin    0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_mec2.bin
firmware/amdgpu/renoir_pfp.bin     0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_pfp.bin
firmware/amdgpu/renoir_rlc.bin     0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_rlc.bin
firmware/amdgpu/renoir_sdma.bin    0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_sdma.bin
firmware/amdgpu/renoir_ta.bin      0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_ta.bin
firmware/amdgpu/renoir_vcn.bin     0644 0:0 vendor_firmware_file firmware/amdgpu/renoir_vcn.bin
firmware/amdgpu/green_sardine_asd.bin   0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_asd.bin
firmware/amdgpu/green_sardine_ce.bin    0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_ce.bin
firmware/amdgpu/green_sardine_dmcub.bin 0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_dmcub.bin
firmware/amdgpu/green_sardine_me.bin    0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_me.bin
firmware/amdgpu/green_sardine_mec.bin   0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_mec.bin
firmware/amdgpu/green_sardine_mec2.bin  0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_mec2.bin
firmware/amdgpu/green_sardine_pfp.bin   0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_pfp.bin
firmware/amdgpu/green_sardine_rlc.bin   0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_rlc.bin
firmware/amdgpu/green_sardine_sdma.bin  0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_sdma.bin
firmware/amdgpu/green_sardine_ta.bin    0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_ta.bin
firmware/amdgpu/green_sardine_vcn.bin   0644 0:0 vendor_firmware_file firmware/amdgpu/green_sardine_vcn.bin
# MT7922 Wi-Fi and Bluetooth; Google's firmware/mediatek/ already holds the MT7961 files.
firmware/mediatek/WIFI_RAM_CODE_MT7922_1.bin        0644 0:0 vendor_firmware_file firmware/mediatek/WIFI_RAM_CODE_MT7922_1.bin
firmware/mediatek/WIFI_MT7922_patch_mcu_1_1_hdr.bin 0644 0:0 vendor_firmware_file firmware/mediatek/WIFI_MT7922_patch_mcu_1_1_hdr.bin
firmware/mediatek/BT_RAM_CODE_MT7922_1_1_hdr.bin    0644 0:0 vendor_firmware_file firmware/mediatek/BT_RAM_CODE_MT7922_1_1_hdr.bin

# No face sensor: stops system_server polling for a face HAL. See no-face.xml.
etc/permissions/dali-no-face.xml                                         0644 0:0    vendor_configs_file         ./no-face.xml

# Generic x86-64 libz from the emulator image; see remove.list.
lib64/libz.so                                                            0644 0:0    same_process_hal_file       emulator/vendor/lib64/libz.so

# Source-built crossystem stub from android/crossystem-qemu.c; keeps Google's metadata.
bin/crossystem                                                           0755 0:2000 firmware_tool_exec          build/crossystem
