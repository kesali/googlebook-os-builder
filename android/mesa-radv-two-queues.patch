# Android HWUI's Vulkan renderer requires two graphics queues. This RADV version exposes one,
# so expose two logical queues and serialize access when they share a hardware ring.
# Drop this patch when upstream safely supports two graphics queues on one ring.

--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -3040,7 +3040,9 @@
             VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT | VK_QUEUE_TRANSFER_BIT | VK_QUEUE_SPARSE_BINDING_BIT;
          *pQueueFamilyProperties[idx] = (VkQueueFamilyProperties){
             .queueFlags = gfx_flags | radv_queue_family_protected_flag(pdev, RADV_QUEUE_GENERAL),
-            .queueCount = 1,
+            /* Android HWUI (skiavk) requires >= 2 queues in the graphics family. The
+             * kernel may expose a single GFX ring: the winsys folds extra queues onto it. */
+            .queueCount = 2,
             .timestampValidBits = 64,
             .minImageTransferGranularity = (VkExtent3D){1, 1, 1},
          };
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
@@ -1334,14 +1334,26 @@
       .cs_emit_signal = true,
    };
 
+   /* Serialize queues that map to the same hardware ring. */
+   const unsigned num_rings = ws->info.ip[submit->ip_type].num_queues;
+   if (!num_rings || submit->queue_index < 0) {
+      fprintf(stderr, "radv/amdgpu: no hardware ring for IP %u, queue %d\n",
+              (unsigned)submit->ip_type, submit->queue_index);
+      result = VK_ERROR_DEVICE_LOST;
+      goto out;
+   }
+   const unsigned ring = (unsigned)submit->queue_index % num_rings;
+
+   simple_mtx_lock(&ctx->submit_lock);
    if (!submit->cs_count) {
-      result = radv_amdgpu_cs_submit_zero(ctx, submit->ip_type, submit->queue_index, &sem_info);
+      result = radv_amdgpu_cs_submit_zero(ctx, submit->ip_type, ring, &sem_info);
    } else {
       result = radv_amdgpu_winsys_cs_submit_internal(
-         ctx, submit->queue_index, &sem_info, submit->cs_array, submit->cs_count, submit->initial_preamble_cs,
+         ctx, ring, &sem_info, submit->cs_array, submit->cs_count, submit->initial_preamble_cs,
          submit->initial_preamble_count, submit->continue_preamble_cs, submit->continue_preamble_count,
          submit->postamble_cs, submit->postamble_count, submit->uses_shadow_regs, submit->secure);
    }
+   simple_mtx_unlock(&ctx->submit_lock);
 
 out:
    STACK_ARRAY_FINISH(wait_points);
@@ -1562,6 +1576,7 @@
       goto fail_create;
    }
    ctx->ws = ws;
+   simple_mtx_init(&ctx->submit_lock, mtx_plain);
 
    assert(AMDGPU_HW_IP_NUM * MAX_RINGS_PER_TYPE * 4 * sizeof(uint64_t) <= 4096);
    result = ws->base.buffer_create(&ws->base, 4096, 8, RADEON_DOMAIN_GTT,
@@ -1575,6 +1590,7 @@
    return VK_SUCCESS;
 
 fail_alloc:
+   simple_mtx_destroy(&ctx->submit_lock);
    ac_drm_cs_ctx_free(ws->dev, ctx->ctx_handle);
 fail_create:
    FREE(ctx);
@@ -1595,6 +1611,7 @@
 
    ctx->ws->base.buffer_destroy(&ctx->ws->base, ctx->fence_bo);
    ac_drm_cs_ctx_free(ctx->ws->dev, ctx->ctx_handle);
+   simple_mtx_destroy(&ctx->submit_lock);
