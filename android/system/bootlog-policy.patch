Google's release image has no writable logpersist domain. Give native logcat and
the one-shot boot rotation helper a dedicated enforcing domain, limited to logd,
their own metadata directory, identity properties and the readiness signal.
No block-device, raw-kmsg read, capability or unrelated storage access is added.
Drop this patch when persistent boot diagnostics are no longer needed.

--- a/system/etc/selinux/plat_sepolicy.cil
+++ b/system/etc/selinux/plat_sepolicy.cil
@@ -87210,3 +87210,47 @@
 (typeattributeset gpu_sphal_domain (hal_graphics_allocator))
 (typeattributeset gpu_sphal_domain (hal_graphics_composer))
 (typeattributeset gpu_sphal_domain (hal_neuralnetworks))
+
+; Dali's native logcat collectors and one-shot rotation helper.
+(type dali_bootlog)
+(roletype object_r dali_bootlog)
+(typeattributeset domain (dali_bootlog))
+(typeattributeset coredomain (dali_bootlog))
+(type dali_bootlog_file)
+(roletype object_r dali_bootlog_file)
+(typeattributeset file_type (dali_bootlog_file))
+(typeattributeset data_file_type (dali_bootlog_file))
+(typeattributeset core_data_file_type (dali_bootlog_file))
+(type dali_bootlog_ready_prop)
+(roletype object_r dali_bootlog_ready_prop)
+(typeattributeset property_type (dali_bootlog_ready_prop))
+(typeattributeset system_property_type (dali_bootlog_ready_prop))
+(typeattributeset system_internal_property_type (dali_bootlog_ready_prop))
+
+(allow init dali_bootlog (process (transition siginh rlimitinh)))
+(dontaudit init dali_bootlog (process (noatsecure)))
+(allow init logcat_exec (file (read getattr map execute open)))
+(allow dali_bootlog shell_exec (file (read getattr map execute open entrypoint execute_no_trans)))
+(allow dali_bootlog logcat_exec (file (read getattr map execute open entrypoint execute_no_trans)))
+(allow dali_bootlog toolbox_exec (file (read getattr map execute open execute_no_trans)))
+(allow dali_bootlog self (process (fork)))
+(allow dali_bootlog proc (dir (search)))
+(allow dali_bootlog proc_random (dir (search)))
+(allow dali_bootlog proc_random (file (read getattr open)))
+(allow dali_bootlog metadata_file (dir (search)))
+(allow dali_bootlog dali_bootlog_file (dir (read getattr open search write add_name remove_name create rmdir rename)))
+(allow dali_bootlog dali_bootlog_file (file (read getattr open write append create rename unlink)))
+(allow init dali_bootlog_file (dir (read getattr open search write add_name remove_name create setattr relabelfrom relabelto)))
+(allow init dali_bootlog_file (file (getattr relabelfrom relabelto)))
+(allow dali_bootlog logdr_socket (sock_file (write)))
+(allow dali_bootlog logd (unix_stream_socket (connectto)))
+(allow dali_bootlog self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
+(allow dali_bootlog kmsg_debug_device (chr_file (write append)))
+(allow dali_bootlog bootloader_prop (file (read getattr open map)))
+(allow dali_bootlog bootloader_boot_reason_prop (file (read getattr open map)))
+(allow dali_bootlog fingerprint_prop (file (read getattr open map)))
+(allow dali_bootlog dali_bootlog_ready_prop (file (read getattr open map)))
+(allow dali_bootlog property_socket (sock_file (write)))
+(allow dali_bootlog init (unix_stream_socket (connectto)))
+(allow dali_bootlog dali_bootlog_ready_prop (property_service (set)))
+(allow init dali_bootlog_ready_prop (property_service (set)))
