# Files added to Google's first-stage module ramdisk (vendor_ramdisk02).
# Sources: gki/ is our source-built GKI's module directory. Ramdisks have no SELinux labels.
# modules.patch loads these, in order; scripts/android-modules.sh checks its dependencies.
#
# path                          mode owner selinux type source
lib/modules/virtio_dma_buf.ko   0644 0:0   -            gki/kernel/drivers/virtio/virtio_dma_buf.ko
lib/modules/virtio-gpu.ko       0644 0:0   -            gki/kernel/drivers/gpu/drm/virtio/virtio-gpu.ko
lib/modules/virtio_input.ko     0644 0:0   -            gki/kernel/drivers/virtio/virtio_input.ko
lib/modules/failover.ko         0644 0:0   -            gki/kernel/net/core/failover.ko
lib/modules/net_failover.ko     0644 0:0   -            gki/kernel/drivers/net/net_failover.ko
lib/modules/virtio_net.ko       0644 0:0   -            gki/kernel/drivers/net/virtio_net.ko
