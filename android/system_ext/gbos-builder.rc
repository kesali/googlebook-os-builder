# Development image: software keys have no hardware-backed security.
import /system_ext/etc/gbos-builder/graphics-softpipe.rc
import /system_ext/etc/gbos-builder/graphics-amd.rc
import /system_ext/etc/gbos-builder/graphics-intel-anv.rc
import /system_ext/etc/gbos-builder/graphics-intel-hasvk.rc

on post-fs-data
    start gbos_builder_graphics_select

on early-init
    # ro.* properties cannot change once set; the system patch leaves this one to init.
    setprop ro.dalvik.vm.native.bridge ${ro.boot.gbos_builder.native_bridge:-libndk_translation.so}
    setprop trusty.security_vm.enabled 0
    setprop remote_provisioning.tee.rkp_only 0
    setprop remote_provisioning.strongbox.rkp_only 0
    setprop remote_provisioning.hostname ""

service gbos_builder_graphics_select /system/bin/sh /system_ext/etc/gbos-builder/graphics-select.sh /sys
    user root
    group root
    seclabel u:r:gbos_builder_graphics_select:s0
    disabled
    oneshot
    stdio_to_kmsg

# Neither the VM nor the MSI has Google's security chip.
service android.system.desktop.security.gscd /system/bin/gscd
    override
    class early_hal
    user hsm
    group hsm
    disabled
# Waits for gscd's IGsc forever, asking servicemanager to start it once a second.
service android.system.desktop.security.udsattestation /system/bin/udsattestation
    override
    class main
    oneshot
    user hsm
    group hsm inet
    disabled
