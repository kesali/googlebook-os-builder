# Development image: software keys have no hardware-backed security.
import /system_ext/etc/gbos-builder/graphics-${ro.boot.gbos_builder.graphics:-softpipe}.rc

on early-init
    # ro.* properties cannot change once set; the system patch leaves this one to init.
    setprop ro.dalvik.vm.native.bridge ${ro.boot.gbos_builder.native_bridge:-libhoudini.so}
    setprop trusty.security_vm.enabled 0
    setprop remote_provisioning.tee.rkp_only 0
    setprop remote_provisioning.strongbox.rkp_only 0
    setprop remote_provisioning.hostname ""
# Neither the VM nor the MSI has Google's security chip.
service android.system.desktop.security.gscd /system/bin/gscd
    override
    class early_hal
    user hsm
    group hsm
    disabled
# Waits for gscd's IGsc forever, asking servicemanager to start it once a second.
service android.system.desktop.security.udsattestation /system/bin/udsattestation
    override
    class main
    oneshot
    user hsm
    group hsm inet
    disabled
