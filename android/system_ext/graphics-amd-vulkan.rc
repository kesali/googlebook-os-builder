# Experimental AMD profile: Vulkan for app UI; choose the normal entry to return to GL.
on early-init
    setprop ro.hardware.egl angle
    setprop ro.hardware.vulkan radeon
    setprop ro.hwui.use_vulkan true
    setprop debug.hwui.renderer skiavk
    setprop debug.renderengine.vulkan true
    setprop debug.renderengine.backend skiavkthreaded
    export MESA_LOADER_DRIVER_OVERRIDE zink
    setprop qemu.sf.lcd_density 160
