# Google's ANGLE GLES and Vulkan RenderEngine use RADV; minigbm uses Mesa GBM/Zink.
on early-init
    setprop ro.hardware.egl angle
    setprop ro.hardware.vulkan radeon
    setprop debug.renderengine.vulkan true
    setprop debug.renderengine.backend skiavkthreaded
    export MESA_LOADER_DRIVER_OVERRIDE zink
    # The MSI's 15.6" 1920x1080 panel at Churro's 180 dpi; Google's ro.sf.lcd_density (240) stays
    # for QEMU. SurfaceFlinger and zygote (so every app) read this property first.
    setprop qemu.sf.lcd_density 180
