# The AMD Mesa backend allocates unsupported planar YUV as a linear R8 buffer. Its plane
# strides otherwise follow the visible width, but RADV on GFX9 requires every linear 8-bit
# plane pitch to be a multiple of 256 bytes. Align luma to 512 so half-width chroma is valid.
# This is the source equivalent of gbos's old dumb-buffer alignment fix, not a binary edit.
# Drop when the backend negotiates per-plane constraints with Mesa.

--- a/gbm_mesa_driver/gbm_mesa_internals.cpp
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -386,6 +386,10 @@
 
 	if (alloc_args.drm_format == 0) {
 		/* Always use linear for spoofed format allocations. */
+		if (format == DRM_FORMAT_YVU420 || format == DRM_FORMAT_YVU420_ANDROID) {
+			/* RADV requires 256-byte alignment for both half-width chroma planes. */
+			alloc_args.width = ALIGN(alloc_args.width, 512);
+		}
 		drv_bo_from_format(bo, alloc_args.width, 1, alloc_args.height, format);
 		bo_layout_ready = true;
 		bo->meta.total_size = ALIGN(bo->meta.total_size, size_align);
