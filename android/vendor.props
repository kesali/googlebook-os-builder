# Fixed QEMU software graphics profile. No host-GPU passthrough.
ro.hardware.egl=mesa
ro.hardware.vulkan=none
ro.hwui.use_vulkan=false
debug.hwui.renderer=skiagl
debug.renderengine.vulkan=false
debug.renderengine.backend=skiaglthreaded
vendor.hwc.drm.enable_color_pipeline=false
vendor.hwc.drm.force_color_mode=7
vendor.hwc.drm.persistent_hdr=false
vendor.hwc.drm.use_log_gamma_lut=false
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.has_HDR_display=false
