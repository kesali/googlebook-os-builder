#!/bin/sh
# A diagnostic shell only. No Android startup, installer, disk formatting or firmware tools.
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
# /dev/console did not exist when the kernel started this rootless-built initramfs.
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts

fail() {
    echo "GBOS-BUILDER BOOT ERROR: $*" >/dev/console
    echo "GBOS-BUILDER BOOT ERROR: $*" >/dev/kmsg
    exec setsid cttyhack sh
}

boot_uuid= test_mode=0
for option in $(cat /proc/cmdline); do
    case "$option" in
        gbos_builder.boot_uuid=*) boot_uuid=${option#*=} ;;
        gbos_builder.test=*) test_mode=${option#*=} ;;
    esac
done
case "$boot_uuid" in
    ""|*[!0-9a-fA-F-]*) fail "Missing or invalid boot filesystem UUID" ;;
esac

# Only inspect USB-backed block devices, and refuse ambiguous cloned filesystems.
device=
for attempt in $(seq 1 20); do
    matches=0
    for entry in /sys/class/block/*; do
        case "$(readlink -f "$entry")" in */usb*/*) ;; *) continue ;; esac
        candidate=/dev/${entry##*/}
        if blkid "$candidate" | grep -qi " UUID=\"$boot_uuid\""; then
            device=$candidate
            matches=$((matches + 1))
        fi
    done
    [ "$matches" -le 1 ] || fail "More than one USB has UUID $boot_uuid"
    [ "$matches" -eq 0 ] || break
    sleep 1
done
[ -n "$device" ] || fail "USB boot filesystem $boot_uuid not found"
mount -t vfat -o rw,nodev,nosuid,noexec "$device" /boot || fail "Cannot mount $device"
[ "$(cat /boot/gbos-builder/format)" = gbos-builder-diagnostic-v1 ] || fail "Not a gbos-builder diagnostic USB"
mkdir -p /boot/logs || fail "Cannot create log directory"
if [ -f /boot/logs/kernel.log ]; then
    mv /boot/logs/kernel.log /boot/logs/kernel.previous.log || fail "Cannot rotate log"
fi
section() { printf '\n== %s\n' "$1"; }
{
    section "Kernel"
    uname -a
    cat /proc/cmdline
    section "PCI: slot, class, vendor, device, subsystem vendor, subsystem, driver"
    lspci -mk | sort
    section "USB: bus, device, vendor:product"
    lsusb | sort
    section "Input (laptop keyboard: AT Translated Set 2, touchpad: ELAN0307)"
    cat /proc/bus/input/devices
    section "I2C (touchpad: i2c-ELAN0307:00)"
    ls /sys/bus/i2c/devices
    section "Partitions"
    cat /proc/partitions
    section "CPU"
    cat /proc/cpuinfo
} > /boot/logs/hardware.txt || fail "Cannot write hardware log"

/bin/isa-smoke >/dev/kmsg 2>&1 || fail "CPU instruction emulation self-test failed"
dmesg > /boot/logs/kernel.log || fail "Cannot write kernel log"
sync
echo "GBOS_BUILDER_DIAGNOSTIC_READY"
echo "GBOS_BUILDER_DIAGNOSTIC_READY" >/dev/kmsg
echo "Diagnostic shell. Android is not started. Logs: /boot/logs"
echo "Use 'umount /boot && poweroff -f' before removing the USB."
if [ "$test_mode" = 1 ]; then
    umount /boot || fail "Cannot unmount boot filesystem"
    poweroff -f
fi
while true; do
    setsid cttyhack sh
    echo "Shell exited; unmount /boot, then use poweroff -f to shut down."
done
